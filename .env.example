# ============================================
# BinanceBot V3.0 — 本地/测试环境变量模板
# ============================================

# --- 基础信息 ---
PROJECT_NAME=BinanceBot V3.0
VERSION=3.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- 核心安全 ---
# 32 字节 url-safe base64（Fernet 兼容）
# 生产环境务必替换，并离线保存
MASTER_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# JWT 登录签名密钥，至少 32 个字符
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32_PLUS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 主网实盘开关：默认关闭
# 仅在完成生产安全审查后才允许改为 true
ALLOW_LIVE_TRADING=false

# --- 基础设施 ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/binancebot
REDIS_URL=redis://127.0.0.1:6379/0

# --- 交易环境 ---
# 本地默认测试网，防止误连主网
BINANCE_TESTNET=true

# 是否忽略地域合规检查
IGNORE_GEO_CHECK=false