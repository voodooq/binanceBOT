# ============================================
# BinanceBot V3.0 — 生产环境变量模板
# ============================================

# --- 基础信息 ---
PROJECT_NAME=BinanceBot V3.0
VERSION=3.0.0
API_V1_STR=/api/v1
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- 核心安全 ---
# 32 字节 url-safe base64（Fernet 兼容）
# 请使用安全工具生成并妥善离线保存
MASTER_ENCRYPTION_KEY=REPLACE_WITH_REAL_FERNET_KEY_BASE64

# JWT 登录签名密钥，至少 32 个字符
JWT_SECRET_KEY=REPLACE_WITH_REAL_LONG_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 主网实盘开关
# 默认必须为 false；仅在完成生产审查后才可置为 true
ALLOW_LIVE_TRADING=false

# --- 基础设施 ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/binancebot
REDIS_URL=redis://127.0.0.1:6379/0

# --- 交易环境 ---
# 生产初始阶段建议仍先使用测试网验证
BINANCE_TESTNET=true

# 地域合规检查
IGNORE_GEO_CHECK=false